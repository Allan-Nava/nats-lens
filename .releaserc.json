{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/npm",
      {
        "npmPublish": false
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "npm run build && npx @vscode/vsce package --no-dependencies -o nats-lens-${nextRelease.version}.vsix",
        "publishCmd": "npx @vscode/vsce publish --no-dependencies --pat \"$VSCE_TOKEN\" --packagePath nats-lens-${nextRelease.version}.vsix"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["package.json", "CHANGELOG.md"],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "nats-lens-*.vsix",
            "label": "NATS Lens ${nextRelease.version} (.vsix)"
          }
        ]
      }
    ]
  ]
}
